# Copy this file to .env and fill in.
# .env is gitignored and excluded from the Docker build context.

# ── KDD Cup 2026 contract (spec §5.2) ─────────────────────────────────
# At evaluation time the organizer's container injects MODEL_API_URL,
# MODEL_API_KEY, MODEL_NAME. For local development you set them
# yourself, pointing to your own LLM endpoint.

# Local dev: point at your own provider (DashScope, Moonshot, OpenAI, ...)
MODEL_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=your_key_here
MODEL_NAME=qwen3.5-35b-a3b

# Legacy / fallback names that llm_client.create_client_from_config()
# also reads. Set MODEL_API_KEY OR DASHSCOPE_API_KEY (whichever resolves
# wins). MODEL_API_KEY is the standard going forward.
DASHSCOPE_API_KEY=your_key_here

# ── Other providers (optional, only if testing with them locally) ────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
